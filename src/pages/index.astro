---
import Layout from '../layouts/Layout.astro';
import { ButtonLink } from '../components/ui';
import { MemberDiscount } from '../components/MemberDiscount';

const NAV = [
  { label: 'Layanan', href: '#services' },
  { label: 'Perusahaan', href: '#company' },
  { label: 'Member', href: '#member' },
];

const STATS = [
  { value: '100+', label: 'Projects Delivered' },
  { value: '50+', label: 'Team Members' },
  { value: '5+', label: 'Years Experience' },
];

const SECTION = 'py-8 md:py-12 lg:py-16';

const SERVICES = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 18.5h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>`,
    title: 'Mobile Apps',
    desc: 'Aplikasi iOS & Android native dan cross-platform yang cepat, stabil, dan siap skala untuk ribuan pengguna.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="14" rx="2.5" stroke="currentColor" stroke-width="1.6" /><path d="M2.5 9h19M6 6.75h.01M8.5 6.75h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>`,
    title: 'Web Apps',
    desc: 'Platform web modern, dashboard, dan sistem internal dengan performa tinggi dan arsitektur yang mudah dikembangkan.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" aria-hidden="true"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-4 3.5v-3.5H5.5A1.5 1.5 0 0 1 4 14.5v-9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><path d="M8.5 8.5h7M8.5 11.5h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>`,
    title: 'Konsultasi',
    desc: 'Product & tech advisory dari discovery hingga roadmap, membantu tim Anda mengambil keputusan teknis yang tepat.',
  },
];
---

<Layout title="NusaBuild - Build Partner untuk Mobile & Web Apps">
  <div class="min-h-screen bg-surface text-ink">
    {/* Header */}
    <header class="sticky top-0 z-30 border-b border-[#eceff3] bg-surface/85 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href="#top" class="flex items-center">
          <img src="/logo_nusabuild.svg" alt="NusaBuild" class="h-8 w-auto" />
        </a>
        <nav class="hidden items-center gap-8 md:flex" aria-label="Utama">
          {NAV.map((n) => (
            <a
              href={n.href}
              class="text-sm font-medium leading-5 text-ink-soft transition-colors hover:text-primary"
            >
              {n.label}
            </a>
          ))}
        </nav>
        <ButtonLink href="#cta" className="px-5">
          Konsultasi Gratis
        </ButtonLink>
      </div>
    </header>

    <main id="top">
      {/* Hero */}
      <section class={`mx-auto max-w-6xl px-4 ${SECTION} lg:pt-24`}>
        <div class="grid items-center gap-12 md:grid-cols-[1.05fr_0.95fr]">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-[#cdeef4] bg-white px-3 py-1.5 text-xs font-medium leading-4 text-primary">
              <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
              Build partner untuk startup & scale-up
            </span>
            <h1 class="mt-6 font-display text-[40px] font-bold leading-[1.1] tracking-tight text-ink md:text-[48px] md:leading-[56px]">
              Wujudkan produk digital yang <span class="text-primary">siap skala</span>, tanpa drama teknis.
            </h1>
            <p class="mt-6 max-w-xl text-base leading-6 text-ink-soft">
              Kami membangun aplikasi mobile & web untuk tim yang serius bertumbuh dari validasi ide
              hingga produk yang dipakai ribuan pengguna.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-3">
              <ButtonLink href="#cta">
                Mulai Konsultasi Gratis
                <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </ButtonLink>
              <ButtonLink href="#services" variant="ghost">
                Lihat Layanan
              </ButtonLink>
            </div>
          </div>

          <div class="relative">
            <div class="overflow-hidden rounded-xl border border-[#e6eaf0] bg-white shadow-[0_24px_60px_-30px_rgba(8,145,178,0.4)]">
              <img
                src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=900&h=760&fit=crop&auto=format"
                alt="Tim engineer berkolaborasi merancang produk digital"
                class="aspect-[9/8] h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="absolute -bottom-5 -left-5 hidden rounded-xl border border-[#e6eaf0] bg-white px-5 py-4 shadow-lg sm:block">
              <p class="font-display text-2xl font-bold leading-8 text-primary">98%</p>
              <p class="text-xs leading-4 text-ink-soft">Klien lanjut ke proyek berikutnya</p>
            </div>
          </div>
        </div>
      </section>

      {/* Company Profile + Stats */}
      <section id="company" class="border-y border-[#eceff3] bg-white">
        <div class={`mx-auto max-w-6xl px-4 ${SECTION}`}>
          <div class="grid gap-12 md:grid-cols-[0.9fr_1.1fr] md:items-center">
            <div>
              <p class="text-sm font-medium uppercase leading-5 tracking-wider text-primary">Tentang Kami</p>
              <h2 class="mt-3 font-display text-[32px] font-semibold leading-10 text-ink">
                Studio engineering yang jadi partner jangka panjang
              </h2>
              <p class="mt-5 text-base leading-6 text-ink-soft">
                NusaBuild adalah tim product & engineering yang membantu founder dan tim produk mengubah
                ide menjadi produk digital nyata. Kami mengutamakan kualitas kode, komunikasi transparan,
                dan hasil yang terukur.
              </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
              {STATS.map((s) => (
                <div
                  class="rounded-xl border border-[#E5E7EB] bg-surface p-6 transition-colors hover:border-primary/40"
                >
                  <p class="font-display text-[32px] font-bold leading-none text-primary">{s.value}</p>
                  <p class="mt-2 text-sm leading-5 text-ink-soft">{s.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* Services */}
      <section id="services" class={`mx-auto max-w-6xl px-4 ${SECTION}`}>
        <div class="max-w-2xl">
          <p class="text-sm font-medium uppercase leading-5 tracking-wider text-primary">Layanan</p>
          <h2 class="mt-3 font-display text-[32px] font-semibold leading-10 text-ink">
            Semua yang tim Anda butuhkan untuk membangun
          </h2>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {SERVICES.map((svc) => (
            <article
              class="group flex flex-col rounded-xl border border-[#E5E7EB] bg-white p-8 transition-shadow duration-200 hover:shadow-[0_16px_36px_-24px_rgba(15,23,42,0.35)]"
            >
              <span class="grid h-12 w-12 place-items-center rounded-lg bg-discount text-primary" set:html={svc.icon}>
              </span>
              <h3 class="mt-5 font-display text-2xl font-semibold leading-8 text-ink">{svc.title}</h3>
              <p class="mt-3 flex-1 text-base leading-6 text-ink-soft">{svc.desc}</p>
              <a
                href="#cta"
                class="mt-6 inline-flex h-11 items-center gap-1.5 text-sm font-semibold leading-5 text-primary transition-colors hover:text-secondary"
              >
                Pelajari lebih lanjut
                <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </article>
          ))}
        </div>
      </section>

      {/* Logos Marquee */}
      <section class="bg-ink overflow-hidden py-12">
        <div class="mx-auto max-w-6xl px-4 text-center mb-10">
          <p class="text-sm font-medium uppercase leading-5 tracking-wider text-white/50">Dipercaya oleh</p>
        </div>
        <div class="relative flex w-full flex-nowrap overflow-hidden [-webkit-mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)] [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
          <div class="flex items-center justify-center md:justify-start [&_img]:max-w-none animate-marquee gap-16 pr-16 w-max hover:[animation-play-state:paused]">
            <!-- Set 1 -->
            <img src="/logo-bapenda.svg" alt="Bapenda" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/Muhammadiyah Logo.svg" alt="Muhammadiyah" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/OJK Logo.svg" alt="OJK" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/PGN (Pertamina Gas Negara).svg" alt="PGN" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/Korps Lalu Lintas.svg" alt="Korlantas" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            
            <!-- Set 2 -->
            <img src="/logo-bapenda.svg" alt="Bapenda" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/Muhammadiyah Logo.svg" alt="Muhammadiyah" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/OJK Logo.svg" alt="OJK" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/PGN (Pertamina Gas Negara).svg" alt="PGN" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
            <img src="/Korps Lalu Lintas.svg" alt="Korlantas" class="h-10 w-auto object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
          </div>
        </div>
      </section>

      {/* Member Discount (Interactive React Component) */}
      <MemberDiscount client:visible />

      {/* CTA — Konsultasi */}
      <section id="cta" class="bg-primary">
        <div class={`mx-auto max-w-4xl px-4 text-center ${SECTION} lg:py-20`}>
          <h2 class="font-display text-[32px] font-semibold leading-10 text-white">
            Mulai Konsultasi Gratis
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-base leading-6 text-white/90">
            Diskusikan ide Anda dengan tim kami tanpa biaya, tanpa komitmen. Dapatkan estimasi lingkup,
            timeline, dan rekomendasi teknis dalam 30 menit.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <ButtonLink href="https://wa.me/6281936101712" target="_blank" rel="noopener noreferrer" variant="outline">
              Jadwalkan Sekarang
              <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M4 10h11m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </ButtonLink>
          </div>
        </div>
      </section>
    </main>

    {/* Footer */}
    <footer class="border-t border-[#eceff3] bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
          <div>
            <a href="#top" class="flex items-center">
              <img src="/logo_nusabuild.svg" alt="NusaBuild" class="h-8 w-auto" />
            </a>
            <p class="mt-4 max-w-xs text-xs leading-4 text-ink-soft">
              Build partner untuk aplikasi mobile & web yang siap bertumbuh.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold leading-5 text-ink">Navigasi</p>
            <ul class="mt-4 space-y-3">
              {NAV.map((n) => (
                <li>
                  <a href={n.href} class="text-xs leading-4 text-ink-soft transition-colors hover:text-primary hover:underline hover:underline-offset-4">
                    {n.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold leading-5 text-ink">Kontak</p>
            <ul class="mt-4 space-y-3 text-xs leading-4 text-ink-soft">
              <li>
                <a href="mailto:halo@nusabuild.id" class="transition-colors hover:text-primary hover:underline hover:underline-offset-4">
                  halo@nusabuild.id
                </a>
              </li>
              <li>
                <a href="https://wa.me/6281936101712" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-primary hover:underline hover:underline-offset-4">
                  +62 819-3610-1712
                </a>
              </li>
              <li>Bali, Indonesia</li>
            </ul>
            <div class="mt-5 flex gap-2">
              {['in', 'X', 'IG'].map((s) => (
                <a
                  href="#top"
                  aria-label={`NusaBuild di ${s}`}
                  class="grid h-11 w-11 place-items-center rounded-lg border border-[#E5E7EB] text-xs font-semibold text-ink-soft transition-colors hover:border-primary hover:text-primary"
                >
                  {s}
                </a>
              ))}
            </div>
          </div>
        </div>
        <div class="mt-10 border-t border-[#eceff3] pt-6 text-xs leading-4 text-ink-soft">
          © 2026 NusaBuild. Seluruh hak cipta dilindungi.
        </div>
      </div>
    </footer>
  </div>
</Layout>
